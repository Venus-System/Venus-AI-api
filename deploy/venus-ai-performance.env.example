# Variáveis não secretas de desempenho. Mantenha as chaves somente no .env da EC2.
# A ordem coloca os modelos Mistral de baixa latência antes dos modelos de
# raciocínio da Groq. O gpt-oss pode levar mais de 30 s em uma etapa do grafo;
# ele fica como fallback, não como primeira tentativa.
LLM_CADEIA_ESPECIALISTA=mistral:ministral-14b-latest,mistral:ministral-8b-latest,groq:openai/gpt-oss-20b,gemini:gemini-3.6-flash,groq:openai/gpt-oss-120b
LLM_CADEIA_RAPIDO=mistral:ministral-8b-latest,mistral:ministral-14b-latest,groq:openai/gpt-oss-20b,gemini:gemini-3.6-flash

# O guardrail permanece ligado por padrão; não desligue sem revisar o impacto de segurança.
VENUS_PRIORIZAR_MODELOS_RAPIDOS=1
# VENUS_GUARDRAIL_LLM=1
