# Variáveis não secretas de desempenho. Mantenha as chaves somente no .env da EC2.
# A ordem prioriza modelos menores/rápidos e conserva fallbacks.
LLM_CADEIA_ESPECIALISTA=groq:openai/gpt-oss-20b,mistral:ministral-14b-latest,mistral:ministral-8b-latest,gemini:gemini-3.6-flash,groq:openai/gpt-oss-120b
LLM_CADEIA_RAPIDO=mistral:ministral-8b-latest,groq:openai/gpt-oss-20b,mistral:ministral-14b-latest,gemini:gemini-3.6-flash

# O guardrail permanece ligado por padrão; não desligue sem revisar o impacto de segurança.
# VENUS_GUARDRAIL_LLM=1
