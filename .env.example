# Copie para .env (o .env nunca vai para o Git) e preencha o que for usar.
# Nenhuma variável é obrigatória para a API subir; sem cada uma, a função
# correspondente fica desligada (ver a tabela "Configuração" do README).
# Na nuvem, os valores vão no gerenciador de segredos, não num arquivo.
#
# Comentários sempre na própria linha: o --env-file do Docker não aceita
# comentário depois do valor. As linhas comentadas têm um padrão que já serve;
# descomente só para trocar.

# --- Modelos de linguagem -----------------------------------------------------
# Cadeia com fallback entre os provedores que tiverem chave. Sem nenhuma, a
# Venus só devolve a mensagem de reserva.
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Ordem das cadeias (provedor:modelo, separados por vírgula). A ordem usada no
# deploy está em deploy/venus-ai-performance.env.example.
# LLM_CADEIA_ESPECIALISTA=
# LLM_CADEIA_RAPIDO=
# Mantém os modelos Mistral rápidos na frente das cadeias (0 desliga).
# VENUS_PRIORIZAR_MODELOS_RAPIDOS=1

# --- Autenticação e acesso ----------------------------------------------------
# Conta de serviço do Firebase: o CAMINHO do JSON (local) ou o CONTEÚDO do JSON
# (nuvem). Sem ela, o chat recusa todas as mensagens.
FIREBASE_CREDENTIALS=
# Origens da web que podem chamar a API, separadas por vírgula e sem barra no
# fim. O app mobile não passa por CORS.
CORS_ORIGENS_PERMITIDAS=http://localhost:5173

# --- Bancos -------------------------------------------------------------------
# Histórico de conversa, memória de longo prazo, métricas e limite de mensagens.
# Sem ela, tudo fica em RAM e se perde ao reiniciar.
MONGODB_URL=
# Postgres do CRUD (produto, ingrediente, alergia, usuário pelo uid do
# Firebase). No ambiente do time, o banco é o Venus-qa, o mesmo do CRUD; o
# Venus-2ano no mesmo servidor é só seed de demonstração.
# Ex.: postgresql://usuario:senha@host:porta/Venus-qa
DATABASE_URL=

# --- Observabilidade (Langfuse) -----------------------------------------------
# Rastreia cada mensagem: tempo de cada nó, tokens, custo e o resultado do turno.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Depende da região da conta (ex.: https://us.cloud.langfuse.com).
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- A2A e health detalhado ---------------------------------------------------
# O servidor A2A em /a2a só liga com as duas: a chave (header X-API-Key) e a
# URL pública da API, sem barra no fim.
A2A_API_KEY=
A2A_BASE_URL=
# Chave do GET /v1/health/detalhado. Sem ela, vale a A2A_API_KEY.
HEALTH_API_KEY=
# JSON {"nome": "http://host:porta"} de agentes A2A que o FAQ pode consultar.
A2A_AGENTES_EXTERNOS=

# --- FAQ: RAG e busca na web --------------------------------------------------
# Outra pasta de documentos do FAQ. Sem ela, usa os empacotados no SDK.
FAQ_DIR=
# Coleção do FAQ no Qdrant. Sem ela, índice local em memória sobre FAQ_DIR.
QDRANT_URL=
QDRANT_API_KEY=
# Pasta do modelo de embeddings (~220 MB). Na imagem Docker já vem preenchida.
FASTEMBED_CACHE_PATH=
# Busca na web pelo servidor MCP da Tavily. Sem ela, DuckDuckGo direto.
TAVILY_API_KEY=
# Executável do servidor MCP da Tavily.
# TAVILY_MCP_COMANDO=tavily-mcp
# JSON com servidores MCP externos para o agente FAQ.
MCP_SERVERS=

# --- Guardrail e limites ------------------------------------------------------
# Segunda camada do guardrail (um LLM rápido por mensagem que a regex deixou
# passar). Ligada por padrão; 0 desliga.
# VENUS_GUARDRAIL_LLM=1
# Mensagens por usuário no /v1/chat; acima disso, 429.
# CHAT_LIMITE_POR_MINUTO=20
# CHAT_LIMITE_POR_DIA=300
# CHAT_LIMITE_MONGO_PAUSA_SEGUNDOS=30
# Tempo máximo de uma mensagem no grafo; passou disso, 504.
# CHAT_TIMEOUT_SEGUNDOS=120

# --- Ambiente -----------------------------------------------------------------
# desenvolvimento, qa ou producao.
AMBIENTE=desenvolvimento

# --- Google Calendar ----------------------------------------------------------
# Cliente OAuth "Aplicativo da Web" do Google Console (o mesmo do app e da web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave Fernet que cifra o refresh_token. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Todo lugar que grava no mesmo Postgres usa a mesma chave.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Redirect URIs aceitas, separadas por vírgula (as mesmas do Google Console).
GOOGLE_REDIRECT_URIS_PERMITIDAS=http://localhost:5173/integracoes/google-agenda

# --- Check-up da rotina (Neo4j) -----------------------------------------------
# Ex.: neo4j+s://xxxx.databases.neo4j.io ou bolt://localhost:7687
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
